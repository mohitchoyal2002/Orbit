# Configure real values with Sites runtime environment variables.
# Never commit credentials or a personal email address.
ORBIT_ADMIN_EMAIL=
ORBIT_RATE_LIMIT_SALT=

# Optional client operations integrations. Set privately through Sites.
ORBIT_CONNECTORS_JSON=
ORBIT_RESEND_KEY=
ORBIT_EMAIL_FROM=
ORBIT_RUNNER_TOKEN=

ORBIT_COACHING_CONNECTORS_JSON={}

ORBIT_GEMINI_KEY=

ORBIT_GEMINI_MODEL=gemini-3.1-flash-lite

ORBIT_GOOGLE_CLIENT_ID=

ORBIT_GOOGLE_CLIENT_SECRET=

# Sarvam model APIs (voice preview); Voice Agents keys are configured per client.
ORBIT_SARVAM_KEY=
# OrbitFlow-owned Voice Agents account. A client must explicitly select useOrbitKey.
ORBIT_SARVAM_VOICE_KEY=
ORBIT_VOICE_CONNECTORS_JSON={}
# Optional per-client committed version pin: {"CLIENT_UUID":{"appId":"AGENT_ID","appVersion":3}}
ORBIT_VOICE_AGENT_VERSIONS_JSON={}
